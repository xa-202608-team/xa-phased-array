+    assert abs(rul[0] - (T - 1)) < 1e-6, f"删失 rul[0] 应为绝对下界窗口数 (T−1), 实={rul[0]}"
+    # 归一化分母必须是 H: rull_norm[0]=(T−1)/H 应 < 0.5 (若以 T−1 为分母会=1)
+    assert (T - 1.0) / H < 0.5, f"H 归一后删失下界应 < 0.5, 得 {(T - 1.0) / H}"
+    assert abs(rul[-1]) < 1e-6, "删失末端 rul 应≈0 (观测终点下界=0)"
