{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component", "metrics", "allowed_conclusions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "component": {"enum": ["battery", "phased_array", "wheel"]},
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minimum", "maximum", "absolute_tolerance"],
        "properties": {
          "minimum": {"type": "number"},
          "maximum": {"type": "number"},
          "absolute_tolerance": {"type": "number", "minimum": 0}
        }
      }
    },
    "allowed_conclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "POSITIVE_TRANSFER_SUPPORTED",
          "TRANSFER_INCONCLUSIVE",
          "NO_POSITIVE_TRANSFER_SUPPORTED",
          "BASELINE_ONLY"
        ]
      },
      "uniqueItems": true
    }
  }
}
