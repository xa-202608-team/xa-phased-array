{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xa-202608-team.github.io/contracts/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "component", "version", "git_commit",
    "contract_version", "config_sha256", "data", "random_seeds",
    "environment", "elapsed_seconds", "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "component": {"enum": ["battery", "phased_array", "wheel"]},
    "version": {"type": "string", "pattern": "^(battery|phased-array|wheel)-v[0-9]+\\.[0-9]+\\.[0-9]+(-rc\\.[0-9]+)?$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contract_version": {"enum": ["component-contract-v1.0.0", "component-contract-v1.1.0"]},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "sha256", "redistributable"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "redistributable": {"type": "boolean"}
        }
      }
    },
    "random_seeds": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "pytorch", "os", "device"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "pytorch": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "device": {"type": "string", "minLength": 1}
      }
    },
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "status": {"const": "REPRODUCE_OK"}
  }
}
