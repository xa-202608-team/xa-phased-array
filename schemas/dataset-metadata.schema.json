{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xa-202608-team.github.io/contracts/dataset-metadata.schema.json",
  "title": "Dataset metadata document",
  "description": "数据集元数据契约：登记时间轴、遥测通道、缺失规则、划分策略、标签派生依据、数据来源与预测设定。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "dataset_id",
    "component_type",
    "time",
    "telemetry",
    "missing_values",
    "split",
    "labels",
    "sources",
    "prediction"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "contract_version": {"const": "component-contract-v1.1.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "component_type": {"enum": ["battery", "phased_array", "wheel"]},
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "format"],
      "properties": {
        "column": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "telemetry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "unit",
          "sampling_frequency",
          "source",
          "prediction_time_available",
          "derived",
          "degradation_relation"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "sampling_frequency": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "prediction_time_available": {
            "type": "boolean",
            "description": "预测时刻该通道是否可获得：true=可作输入特征，false=仅评估用（未来信息）。"
          },
          "derived": {
            "type": "boolean",
            "description": "该通道是否由预处理脚本从原始量派生（true=派生特征，false=原始观测）。"
          },
          "degradation_relation": {
            "enum": ["increasing", "decreasing", "none"],
            "description": "该通道随退化演进的方向：increasing=随退化增大，decreasing=随退化减小，none=与退化无单调关系。"
          }
        }
      }
    },
    "missing_values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {"const": "by_component_id"},
        "assignment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "train": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "validation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "test": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "inference": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derivation"],
      "properties": {
        "derivation": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "url", "license", "sha256", "processing_script"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "url": {
            "description": "外部数据必须为合法 https URL；纯本地仿真生成允许 null，此时 processing_script 与 sha256 必须完整给出。不得用空字符串规避溯源。",
            "anyOf": [
              {"type": "string", "pattern": "^https://"},
              {"type": "null"}
            ]
          },
          "license": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "processing_script": {"type": "string", "minLength": 1}
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_telemetry",
        "degradation_direction",
        "failure_threshold",
        "forecast_horizon",
        "rul_unit"
      ],
      "properties": {
        "primary_telemetry": {"type": "string", "minLength": 1},
        "degradation_direction": {
          "enum": ["increasing", "decreasing"],
          "description": "主遥测随退化演进的方向：decreasing 表示退化越重取值越低（如电压/容量），increasing 表示退化越重取值越高。"
        },
        "failure_threshold": {
          "type": "number",
          "description": "主遥测的失效判定阈值，配合 degradation_direction 判定失效。"
        },
        "forecast_horizon": {
          "type": "integer",
          "minimum": 1,
          "description": "预测步数（向前预测的最大步数）。"
        },
        "rul_unit": {"type": "string", "minLength": 1}
      }
    }
  }
}
