{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xa-202608-team.github.io/contracts/rul-prediction.schema.json",
  "title": "GRU channel RUL prediction document",
  "description": "python -m component.predict_gru 产出的通道级 RUL 预测文档（F1 批3 推理契约）。rul_norm 为模型归一口径（÷H），rul_windows/rul_days 为按 bundle 元数据还原的物理口径；不含任何真值字段（additionalProperties=false，标签不得混入推理输出）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "component",
    "method",
    "git_commit",
    "generated_at",
    "model",
    "rul_scale",
    "predictions",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_version": {"const": "component-contract-v1.1.0"},
    "component": {"const": "phased_array"},
    "method": {"const": "gru_channel_rul"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at": {"type": "string", "format": "date-time", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "seed", "encoder", "input_len_L", "feature_names", "val_rmse"],
      "properties": {
        "group": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "encoder": {"type": "string", "minLength": 1},
        "input_len_L": {"type": "integer", "minimum": 1},
        "feature_names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "val_rmse": {"type": "number", "minimum": 0}
      }
    },
    "rul_scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_label_schema", "rul_scale_windows", "sample_period_s"],
      "properties": {
        "channel_label_schema": {"const": "channel_label_v2"},
        "rul_scale_windows": {"type": "number", "exclusiveMinimum": 0},
        "sample_period_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_key",
          "traj_id",
          "sub_id",
          "window_end_index",
          "rul_norm",
          "rul_windows",
          "rul_days"
        ],
        "properties": {
          "channel_key": {"type": "integer", "minimum": 0},
          "traj_id": {"type": "integer", "minimum": 0},
          "sub_id": {"type": "integer", "minimum": 0},
          "window_end_index": {"type": "integer", "minimum": 0},
          "rul_norm": {"type": "number", "minimum": 0},
          "rul_windows": {"type": "number", "minimum": 0},
          "rul_days": {"type": "number", "minimum": 0}
        }
      }
    },
    "status": {"const": "RUL_PREDICTION_OK"}
  }
}
